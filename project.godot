; Engine configuration file.
; Scopa: Four Realms — a mobile-first fantasy Scopa card game.

config_version=5

[application]

config/name="Scopa: Four Realms"
config/description="A mobile-first fantasy reimagining of Scopa: four factions, faction Oaths, public quests and short duels."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.078, 0.071, 0.109, 1)
boot_splash/show_image=false

[autoload]

Sfx="*res://scripts/sfx.gd"
Profile="*res://scripts/profile.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/size/stretch/mode="canvas_items"
window/size/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

; Godot 4.7: "mobile" (Vulkan/Metal) is the best-tested path on desktop and
; phones; the engine falls back to OpenGL3 automatically if Vulkan is
; missing (rendering/rendering_device/fallback_to_opengl3). Web stays GL.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
environment/defaults/default_clear_color=Color(0.078, 0.071, 0.109, 1)
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=0

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
