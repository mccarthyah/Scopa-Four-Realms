; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Scopa: Four Realms"
config/description="A mobile-first fantasy reimagining of Scopa: four factions, faction Oaths, public quests and short duels."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=60
boot_splash/bg_color=Color(0.078, 0.071, 0.109, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Sfx="*res://scripts/sfx.gd"
Profile="*res://scripts/profile.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_to_stdout=true
editor/run/main_run_args=""
editor/run/auto_run_on_open=false
editor/rendering/use_hdr_2d=false

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; Sensor permits both portrait and either landscape direction on mobile.
window/handheld/orientation=6

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

rendering_device/fallback_to_vulkan=false
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.078, 0.071, 0.109, 1)
